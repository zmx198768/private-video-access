DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_CODE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=video.example.com
CSRF_TRUSTED_ORIGINS=https://video.example.com
DB_ENGINE=mysql
DB_NAME=private_video
DB_USER=private_video
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/4
CHAT_REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/5
USE_REDIS_CACHE=1
USE_REDIS_CHANNEL_LAYER=1
CHAT_MESSAGE_MAX_LENGTH=2000
CHAT_SEND_RATE_PER_MINUTE=30
CHAT_ENTRY_RATE_PER_MINUTE=10
CHAT_IDENTITY_DAYS=30
CHAT_IMAGE_DIR=/var/lib/private-video/chat-images
CHAT_IMAGE_MAX_BYTES=8388608
CHAT_IMAGE_MAX_PIXELS=25000000
CHAT_IMAGE_MAX_DIMENSION=4096
VIDEO_SOURCE_DIR=/video
VIDEO_HLS_DIR=/var/lib/private-video/hls
MAX_VIDEO_UPLOAD_BYTES=2147483648
TRUST_PROXY_HEADERS=1
COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
TIME_ZONE=Asia/Shanghai
