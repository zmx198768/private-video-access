[Unit]
Description=Private Video Celery Beat
After=network.target redis.service

[Service]
Type=simple
User=privatevideo
Group=privatevideo
WorkingDirectory=/opt/private-video
EnvironmentFile=/etc/private-video.env
ExecStart=/opt/private-video/.venv/bin/celery -A private_video beat --loglevel=INFO --schedule=/var/lib/private-video/celerybeat-schedule
Restart=always
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
