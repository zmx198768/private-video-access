[Unit]
Description=Private Video Celery Worker
After=network.target mysqld.service redis.service

[Service]
Type=simple
User=privatevideo
Group=privatevideo
WorkingDirectory=/opt/private-video
EnvironmentFile=/etc/private-video.env
ExecStart=/opt/private-video/.venv/bin/celery -A private_video worker --loglevel=INFO --concurrency=1 --max-tasks-per-child=10
Restart=always
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
